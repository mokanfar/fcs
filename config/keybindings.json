{
  "settings": {
    "chord_timeout_ms": 1000,
    "show_hidden_files": false,
    "editor": "subl",
    "search_roots": ["~/Desktop", "~/Downloads", "~/Documents"]
  },
  "keybindings": {
    "home_screen": {
      "f": "search.find_file",
      "d": "search.find_directory",
      "c": "search.find_content",
      "r": "search.recents",
      "p": "search.projects",
      "b": "bucket.open"
    },
    "action_menu": {
      "m": "action.move",
      "c": "submenu.copy",
      "x": "action.cut",
      "e": "action.edit",
      "b": "action.bucket",
      "o": "submenu.open",
      "p": "action.paste",
      "h": "nav.home"
    }
  }
}
